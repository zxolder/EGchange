# Global hotkey that triggers a screen capture + translate (see the `keyboard`
# package docs for valid combos), e.g. ctrl+alt+t, f9, ctrl+shift+z
SCREEN_TRANSLATOR_HOTKEY=ctrl+alt+t

# What to capture: active_window (only the current foreground window, faster)
# or full_screen (the entire virtual screen, all monitors)
CAPTURE_MODE=active_window

# Language OCR should look for on screen (BCP-47 tag understood by Windows OCR)
OCR_SOURCE_LANG=en

# Target language for translation (deep-translator language code)
TRANSLATE_TARGET=zh-TW

# Which translation backend to use: google (free, no key), deepl, microsoft, gemini
TRANSLATE_ENGINE=google

# Only needed when TRANSLATE_ENGINE=deepl
# DEEPL_API_KEY=your-deepl-api-key

# Only needed when TRANSLATE_ENGINE=microsoft
# MS_TRANSLATOR_KEY=your-azure-translator-key
# MS_TRANSLATOR_REGION=global

# Only needed when TRANSLATE_ENGINE=gemini (Google AI Studio / Gemini API key)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash

# How many seconds the overlay stays visible before auto-hiding (0 = never)
AUTO_HIDE_SECONDS=8
